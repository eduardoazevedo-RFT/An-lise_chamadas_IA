# Substitua SEU_DOMINIO.COM pelo seu dominio real
SEU_DOMINIO.COM {
    # Frontend (Next.js)
    handle_path / {
        reverse_proxy frontend:3000
    }

    # API Backend
    handle_path /api/* {
        reverse_proxy backend:8000
    }

    # Gravacoes proxy
    handle_path /gravacao/* {
        reverse_proxy backend:8000
    }
}
